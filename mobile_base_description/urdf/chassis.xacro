<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Shifts a ground-referenced z into base_link coordinates. -->
  <xacro:property name="deck_z_offset" value="${-base_link_height}"/>

  <!-- One deck plate, placed by the ground-referenced z of its bottom face.

       The plate outline is the body rectangle with the four wheel wells cut
       out and the four bumper corners chamfered at 45 degrees from the wheel
       line. URDF has no prism primitive, so unlike the collision limbs below
       the outline cannot be built from boxes - it is a mesh, generated from
       these same properties by scripts/generate_deck_mesh.py and checked
       against them by the verify_deck_mesh test so it cannot drift.

       Both decks are identical, so one mesh serves both. It is authored
       centred on the plate, so the visual needs no pose of its own beyond the
       plate's height. -->
  <xacro:macro name="deck_plate" params="bottom_z thickness">
    <visual>
      <origin xyz="0 0 ${bottom_z + thickness / 2.0 + deck_z_offset}"
              rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://mobile_base_description/meshes/decks/deck_plate.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="base_dark"/>
    </visual>
  </xacro:macro>

  <!-- One collision limb, spanning the full body height. -->
  <xacro:macro name="deck_limb_collision" params="x y length width">
    <collision>
      <origin xyz="${x} ${y} ${chassis_center_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${length} ${width} ${chassis_height}"/>
      </geometry>
    </collision>
  </xacro:macro>

  <!-- One corner standoff spanning the electronics bay. -->
  <xacro:macro name="deck_standoff" params="x y">
    <visual>
      <origin
        xyz="${x} ${y} ${lower_deck_top_z + deck_gap / 2.0 + deck_z_offset}"
        rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${standoff_radius}" length="${deck_gap}"/>
      </geometry>
      <material name="sensor_grey"/>
    </visual>
  </xacro:macro>

  <!-- Combined inertial for the two deck plates, about their common centre. -->
  <xacro:property name="deck_pair_separation"
                  value="${upper_deck_bottom_z + upper_deck_thickness / 2.0
                           - (lower_deck_bottom_z
                              + lower_deck_thickness / 2.0)}"/>
  <xacro:property name="deck_pair_mass" value="${2.0 * deck_mass}"/>
  <!-- Plan-view second moments of one deck plate about its own centre,
       summed over the five limbs. Each limb contributes its own rectangle
       term plus the parallel-axis term for its offset from that centre.
       Dividing by deck_area turns these into the radii of gyration the
       inertial below scales by mass. -->
  <xacro:property name="deck_ixx_plan"
                  value="${(spine_length * chassis_width
                            * chassis_width * chassis_width) / 12.0
                           + 2.0 * (cap_length * chassis_overall_width
                                    * chassis_overall_width
                                    * chassis_overall_width) / 12.0
                           + 2.0 * (wing_length * wing_width
                                    * (wing_width * wing_width / 12.0
                                       + wing_y * wing_y))}"/>
  <xacro:property name="deck_iyy_plan"
                  value="${(chassis_width * spine_length
                            * spine_length * spine_length) / 12.0
                           + 2.0 * (cap_length * chassis_overall_width
                                    * (cap_length * cap_length / 12.0
                                       + cap_x * cap_x))
                           + 2.0 * (wing_width * wing_length
                                    * wing_length * wing_length) / 12.0}"/>
  <xacro:property name="deck_area"
                  value="${spine_length * chassis_width
                           + 2.0 * cap_length * chassis_overall_width
                           + 2.0 * wing_length * wing_width}"/>

  <xacro:macro name="deck_pair_inertial">
    <inertial>
      <origin xyz="0 0 ${chassis_center_z}" rpy="0 0 0"/>
      <mass value="${deck_pair_mass}"/>
      <inertia
        ixx="${deck_pair_mass * (deck_ixx_plan / deck_area
                                 + deck_thickness * deck_thickness / 12.0
                                 + deck_pair_separation
                                   * deck_pair_separation / 4.0)}"
        ixy="0.0" ixz="0.0"
        iyy="${deck_pair_mass * (deck_iyy_plan / deck_area
                                 + deck_thickness * deck_thickness / 12.0
                                 + deck_pair_separation
                                   * deck_pair_separation / 4.0)}"
        iyz="0.0"
        izz="${deck_pair_mass * (deck_ixx_plan + deck_iyy_plan) / deck_area}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="mobile_base_chassis" params="prefix">
    <link name="${prefix}base_footprint"/>

    <joint name="${prefix}base_footprint_to_base_link_joint" type="fixed">
      <parent link="${prefix}base_footprint"/>
      <child link="${prefix}base_link"/>
      <origin xyz="0 0 ${base_link_height}" rpy="0 0 0"/>
    </joint>

    <!-- The body is a dual-deck plate frame, not a solid block: separate
         visuals for each plate, each wing, and each corner standoff.

         Collision approximates that outline with one box per limb, spanning
         the full body height. The planner still cannot route through the open
         electronics bay, and the limbs leave the four wheel wells open
         instead of a single envelope box engulfing the wheels. The boxes keep
         square bumper corners where the plate is chamfered, so collision
         over-claims two small triangles at each end: boxes are cheaper and
         steadier in contact than a mesh, and erring outwards is the safe
         direction for a footprint. -->
    <link name="${prefix}base_link">
      <xacro:deck_plate bottom_z="${lower_deck_bottom_z}"
                        thickness="${lower_deck_thickness}"/>
      <xacro:deck_plate bottom_z="${upper_deck_bottom_z}"
                        thickness="${upper_deck_thickness}"/>

      <xacro:deck_standoff x="${standoff_x}" y="${standoff_y}"/>
      <xacro:deck_standoff x="${standoff_x}" y="${-standoff_y}"/>
      <xacro:deck_standoff x="${-standoff_x}" y="${standoff_y}"/>
      <xacro:deck_standoff x="${-standoff_x}" y="${-standoff_y}"/>

      <xacro:deck_limb_collision x="0" y="0"
                                 length="${spine_length}"
                                 width="${chassis_width}"/>
      <xacro:deck_limb_collision x="${cap_x}" y="0"
                                 length="${cap_length}"
                                 width="${chassis_overall_width}"/>
      <xacro:deck_limb_collision x="${-cap_x}" y="0"
                                 length="${cap_length}"
                                 width="${chassis_overall_width}"/>
      <xacro:deck_limb_collision x="0" y="${wing_y}"
                                 length="${wing_length}"
                                 width="${wing_width}"/>
      <xacro:deck_limb_collision x="0" y="${-wing_y}"
                                 length="${wing_length}"
                                 width="${wing_width}"/>

      <!-- The structural mass is the two plates, so it is carried at the
           plates rather than at the mid-height of an imaginary solid body.
           URDF allows one inertial per link, so the two plates are combined
           here: equal masses at equal distances either side of their midpoint,
           which is what a single box of their combined span and the plate
           footprint already integrates to about the horizontal axes. The
           parallel-axis term for the vertical separation is added explicitly,
           since a solid box of that height would understate it. -->
      <xacro:deck_pair_inertial/>
    </link>
  </xacro:macro>
</robot>
