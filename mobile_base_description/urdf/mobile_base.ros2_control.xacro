<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="mobile_base_ros2_control" params="prefix use_gazebo controllers_file">
    <ros2_control name="${prefix}MobileBaseSystem" type="system">
      <hardware>
        <xacro:if value="${use_gazebo}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_gazebo}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">false</param>
        </xacro:unless>
      </hardware>

      <xacro:macro name="wheel_interface" params="joint_name">
        <joint name="${prefix}${joint_name}">
          <command_interface name="velocity">
            <param name="min">-25.0</param>
            <param name="max">25.0</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:macro>

      <xacro:macro name="roller_state_interfaces"
                   params="wheel_name index:=0">
        <xacro:if value="${index &lt; roller_count}">
          <joint name="${prefix}${wheel_name}_roller_${index}_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
          </joint>
          <xacro:roller_state_interfaces wheel_name="${wheel_name}"
                                         index="${index + 1}"/>
        </xacro:if>
      </xacro:macro>

      <xacro:wheel_interface joint_name="front_left_wheel_joint"/>
      <xacro:wheel_interface joint_name="front_right_wheel_joint"/>
      <xacro:wheel_interface joint_name="rear_right_wheel_joint"/>
      <xacro:wheel_interface joint_name="rear_left_wheel_joint"/>
      <xacro:roller_state_interfaces wheel_name="front_left"/>
      <xacro:roller_state_interfaces wheel_name="front_right"/>
      <xacro:roller_state_interfaces wheel_name="rear_right"/>
      <xacro:roller_state_interfaces wheel_name="rear_left"/>
    </ros2_control>
  </xacro:macro>
</robot>
