<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="mobile_base_imu_gazebo" params="prefix">
    <gazebo reference="${prefix}imu_link">
      <sensor name="${prefix}imu" type="imu">
        <always_on>true</always_on>
        <update_rate>${imu_update_rate}</update_rate>
        <visualize>false</visualize>
        <topic>/imu/data</topic>
        <gz_frame_id>${prefix}imu_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>${imu_angular_velocity_noise_mean}</mean>
                <stddev>${imu_angular_velocity_noise_stddev}</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>${imu_angular_velocity_noise_mean}</mean>
                <stddev>${imu_angular_velocity_noise_stddev}</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>${imu_angular_velocity_noise_mean}</mean>
                <stddev>${imu_angular_velocity_noise_stddev}</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>${imu_linear_acceleration_noise_mean}</mean>
                <stddev>${imu_linear_acceleration_noise_stddev}</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>${imu_linear_acceleration_noise_mean}</mean>
                <stddev>${imu_linear_acceleration_noise_stddev}</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>${imu_linear_acceleration_noise_mean}</mean>
                <stddev>${imu_linear_acceleration_noise_stddev}</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
