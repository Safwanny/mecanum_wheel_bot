<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- REP-103: +X forward, +Y left, +Z up. All dimensions are SI units. -->
  <xacro:property name="chassis_length" value="0.216"/>
  <xacro:property name="chassis_width" value="0.099"/>
  <xacro:property name="chassis_height" value="0.050"/>
  <xacro:property name="chassis_mass" value="1.80"/>

  <!-- Measured from the four wheel STL roller envelopes (millimetres on export). -->
  <xacro:property name="wheel_radius" value="0.03074443"/>
  <xacro:property name="wheel_width" value="0.03360543"/>
  <xacro:property name="wheel_mass" value="0.12"/>
  <xacro:property name="roller_count" value="10"/>
  <xacro:property name="roller_center_radius" value="0.02505"/>
  <xacro:property name="roller_radius"
                  value="${wheel_radius - roller_center_radius}"/>
  <xacro:property name="roller_length" value="0.02580"/>
  <xacro:property name="roller_inclination" value="${pi / 4.0}"/>
  <xacro:property name="roller_mass" value="${wheel_mass * 0.03}"/>
  <xacro:property name="wheel_hub_mass"
                  value="${wheel_mass - roller_count * roller_mass}"/>
  <xacro:property name="roller_joint_damping"
                  value="$(arg roller_joint_damping)"/>
  <xacro:property name="roller_joint_friction"
                  value="$(arg roller_joint_friction)"/>
  <xacro:property name="roller_collision_model"
                  value="$(arg roller_collision_model)"/>
  <!--
    Contact friction and stiffness (mu, mu2, kp, kd) are intentionally absent
    here. They cannot be expressed in a URDF that survives gz sdf -p, so they
    are applied by mobile_base_bringup/scripts/generate_sim_sdf.py when the
    simulation SDF is produced. The roller_contact_mu xacro argument is still
    accepted so callers can pass it uniformly, but it shapes the generated
    SDF rather than this description.
  -->

  <!-- wheelbase is front-to-rear wheel-center spacing; wheel_separation is track width. -->
  <xacro:property name="wheelbase" value="0.150"/>
  <xacro:property name="wheel_separation" value="0.134"/>
  <xacro:property name="wheel_diameter" value="${2.0 * wheel_radius}"/>

  <xacro:property name="chassis_bottom_z" value="${0.25 * wheel_diameter}"/>
  <xacro:property name="base_link_height" value="${chassis_bottom_z + chassis_height / 2.0}"/>
  <xacro:property name="wheel_z" value="${wheel_radius - base_link_height}"/>

  <xacro:property name="camera_depth" value="0.002"/>
  <xacro:property name="camera_width" value="0.010"/>
  <xacro:property name="camera_height" value="0.005"/>
  <xacro:property name="camera_mass" value="0.06"/>
  <xacro:property name="camera_update_rate" value="20"/>
  <xacro:property name="camera_image_width" value="640"/>
  <xacro:property name="camera_image_height" value="480"/>
  <xacro:property name="camera_horizontal_fov" value="1.047"/>
  <xacro:property name="camera_clip_near" value="0.05"/>
  <xacro:property name="camera_clip_far" value="15.0"/>
  <xacro:property name="camera_noise_mean" value="0.0"/>
  <xacro:property name="camera_noise_stddev" value="0.005"/>

  <!-- Simulated 360-degree planar LiDAR. The link origin is the scan plane. -->
  <xacro:property name="lidar_radius" value="0.020"/>
  <xacro:property name="lidar_height" value="0.008"/>
  <xacro:property name="lidar_mass" value="0.10"/>
  <xacro:property name="lidar_x" value="0.0"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_samples" value="720"/>
  <xacro:property name="lidar_update_rate" value="10.0"/>
  <xacro:property name="lidar_min_angle" value="${-pi}"/>
  <xacro:property name="lidar_max_angle" value="${pi}"/>
  <xacro:property name="lidar_min_range" value="0.10"/>
  <xacro:property name="lidar_max_range" value="4.0"/>
  <xacro:property name="lidar_range_resolution" value="0.01"/>
  <xacro:property name="lidar_noise_mean" value="0.0"/>
  <xacro:property name="lidar_noise_stddev" value="0.01"/>

  <!-- Simulated IMU. Noise values are standard deviations in SI units. -->
  <xacro:property name="imu_length" value="0.050"/>
  <xacro:property name="imu_width" value="0.050"/>
  <xacro:property name="imu_height" value="0.008"/>
  <xacro:property name="imu_mass" value="0.03"/>
  <xacro:property name="imu_x" value="0.0"/>
  <xacro:property name="imu_y" value="0.0"/>
  <!-- Compact sensor stack: IMU on the chassis, LiDAR on the IMU. -->
  <xacro:property name="chassis_top_z" value="${chassis_height / 2.0}"/>
  <xacro:property name="imu_z" value="${chassis_top_z + imu_height / 2.0}"/>
  <!-- lidar_link is the scan plane at the top of the LiDAR cylinder. -->
  <xacro:property name="lidar_z"
                  value="${imu_z + imu_height / 2.0 + lidar_height}"/>
  <xacro:property name="imu_update_rate" value="50.0"/>
  <xacro:property name="imu_angular_velocity_noise_mean" value="0.0"/>
  <xacro:property name="imu_angular_velocity_noise_stddev" value="0.002"/>
  <xacro:property name="imu_linear_acceleration_noise_mean" value="0.0"/>
  <xacro:property name="imu_linear_acceleration_noise_stddev" value="0.02"/>
</robot>
