<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Mecanum 01 Rev D. REP-103: +X forward, +Y left, +Z up, SI units.
       Dimensions from the Rev D README (builds/Rev_D); the meshes come from
       scripts/split_rev_d_mesh.py, which checks the same numbers. -->

  <!-- Hull bounding box. The underside sits 11.56 mm off the ground. -->
  <xacro:property name="hull_length" value="0.2959"/>
  <xacro:property name="hull_width" value="0.1688"/>
  <xacro:property name="hull_height" value="0.049"/>
  <xacro:property name="hull_bottom_z" value="0.01156"/>

  <!-- 60 mm printed mecanum wheel: roller envelope 59.92, 31.5 over the
       plates. FL and RR are hand A, FR and RL hand B. -->
  <xacro:property name="wheel_radius" value="0.02996"/>
  <xacro:property name="wheel_width" value="0.0315"/>
  <!-- wheelbase: front-to-rear axle spacing; wheel_separation: track. -->
  <xacro:property name="wheelbase" value="0.210"/>
  <xacro:property name="wheel_separation" value="0.1865"/>

  <!-- base_link sits on the axle line, so the wheel joints are at z = 0. -->
  <xacro:property name="base_link_height" value="${wheel_radius}"/>

  <!-- JGY370 worm motor, direct drive. 100 rpm assumed until the real
       gearing is known: 10.47 rad/s, 0.31 m/s at the wheel. -->
  <xacro:property name="wheel_max_velocity" value="10.47"/>
  <xacro:property name="wheel_joint_damping" value="0.001"/>
  <xacro:property name="wheel_joint_friction" value="0.001"/>

  <!-- Mass estimate from the BOM: 4 x JGY370 (~0.14), printed hull and deck,
       battery and electronics. The wheel carries its drive line too (rollers,
       hub, axle, coupler, motor shaft). Calibration knobs, not measurements:
       weigh the built robot and put the numbers here. -->
  <xacro:property name="body_mass" value="1.40"/>
  <xacro:property name="body_com_z" value="0.030"/>
  <xacro:property name="wheel_mass" value="0.08"/>

  <!-- Deck plate top face; its M3 insert grid is 20 mm pitch, rows at
       x = 60 .. -60 mm, columns at y = +-10 and +-30 mm. -->
  <xacro:property name="deck_top_z" value="0.05806"/>

  <!-- 360-degree planar LiDAR, shaped after the D500 kit: square fixed base,
       cylindrical rotating head. Bolted on the deck grid over rows 2-3 from
       the front and the middle two columns, holes (40, +-10) and (20, +-10)
       mm, so its centre is x = 30 mm on the centreline. lidar_link is the
       scan plane, mid height of the head: 73 mm, clear of the 61.3 mm hull
       and the 60 mm wheel tops. -->
  <xacro:property name="lidar_base_size" value="0.048"/>
  <xacro:property name="lidar_base_height" value="0.010"/>
  <xacro:property name="lidar_head_radius" value="0.019"/>
  <xacro:property name="lidar_head_height" value="0.010"/>
  <xacro:property name="lidar_height"
                  value="${lidar_base_height + lidar_head_height}"/>
  <xacro:property name="lidar_collision_z" value="${-lidar_base_height / 2.0}"/>
  <xacro:property name="lidar_mass" value="0.10"/>
  <xacro:property name="lidar_x" value="0.030"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z"
                  value="${deck_top_z + lidar_base_height
                           + lidar_head_height / 2.0 - base_link_height}"/>
  <xacro:property name="lidar_samples" value="720"/>
  <xacro:property name="lidar_update_rate" value="10.0"/>
  <xacro:property name="lidar_min_angle" value="${-pi}"/>
  <xacro:property name="lidar_max_angle" value="${pi}"/>
  <xacro:property name="lidar_min_range" value="0.10"/>
  <xacro:property name="lidar_max_range" value="4.0"/>
  <xacro:property name="lidar_range_resolution" value="0.01"/>
  <xacro:property name="lidar_noise_mean" value="0.0"/>
  <xacro:property name="lidar_noise_stddev" value="0.01"/>

  <!-- Simulated IMU, on the floor of the hull at the centre. -->
  <xacro:property name="imu_length" value="0.025"/>
  <xacro:property name="imu_width" value="0.025"/>
  <xacro:property name="imu_height" value="0.004"/>
  <xacro:property name="imu_mass" value="0.003"/>
  <xacro:property name="imu_x" value="0.0"/>
  <xacro:property name="imu_y" value="0.0"/>
  <xacro:property name="imu_z" value="${0.016 - base_link_height}"/>
  <xacro:property name="imu_update_rate" value="50.0"/>
  <xacro:property name="imu_angular_velocity_noise_mean" value="0.0"/>
  <xacro:property name="imu_angular_velocity_noise_stddev" value="0.002"/>
  <xacro:property name="imu_linear_acceleration_noise_mean" value="0.0"/>
  <xacro:property name="imu_linear_acceleration_noise_stddev" value="0.02"/>
</robot>
