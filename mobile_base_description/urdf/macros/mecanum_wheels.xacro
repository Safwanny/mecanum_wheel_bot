<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- One driven wheel. The mesh is in the joint frame (origin on the axle at
       the wheel centre, metres) and carries the motor shaft, coupler and axle,
       so the whole drive line turns with the joint. -->
  <xacro:macro name="mecanum_wheel" params="prefix name mesh x y">
    <link name="${prefix}${name}_wheel_link">
      <visual>
        <geometry>
          <mesh filename="package://mobile_base_description/meshes/rev_d/${mesh}"/>
        </geometry>
        <material name="wheel_orange"/>
      </visual>

      <collision name="wheel_collision">
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <xacro:cylinder_inertial mass="${wheel_mass}" radius="${wheel_radius}"
                               length="${wheel_width}">
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
      </xacro:cylinder_inertial>
    </link>

    <joint name="${prefix}${name}_wheel_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}${name}_wheel_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="${wheel_joint_damping}"
                friction="${wheel_joint_friction}"/>
      <limit effort="8.0" velocity="${wheel_max_velocity}"/>
    </joint>

    <!-- No contact parameters here: gz sdf -p drops them. generate_sim_sdf.py
         injects the anisotropic mecanum surface after conversion. -->
    <gazebo reference="${prefix}${name}_wheel_link">
      <selfCollide>false</selfCollide>
    </gazebo>
  </xacro:macro>
</robot>
