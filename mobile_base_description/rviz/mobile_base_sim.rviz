Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Cell Size: 0.05
      Plane Cell Count: 40
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Name: Robot Model
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Marker Scale: 0.15
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Value: false
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/LaserScan
      Color: 170; 140; 255
      Color Transformer: FlatColor
      Decay Time: 0.25
      Enabled: true
      Name: LiDAR Scan
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.01
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_common/Group
          Displays:
            - Alpha: 1
              Autocompute Intensity Bounds: true
              Class: rviz_default_plugins/PointCloud2
              Color: 200; 210; 220
              Color Transformer: FlatColor
              Decay Time: 0
              Enabled: true
              Name: Front
              Position Transformer: XYZ
              Selectable: true
              Size (Pixels): 3
              Size (m): 0.004
              Style: Points
              Topic:
                Depth: 5
                Durability Policy: Volatile
                History Policy: Keep Last
                Reliability Policy: Best Effort
                Value: /tof/front/points
              Use Fixed Frame: true
              Value: true
            - Alpha: 1
              Autocompute Intensity Bounds: true
              Class: rviz_default_plugins/PointCloud2
              Color: 200; 210; 220
              Color Transformer: FlatColor
              Decay Time: 0
              Enabled: true
              Name: Front Left
              Position Transformer: XYZ
              Selectable: true
              Size (Pixels): 3
              Size (m): 0.004
              Style: Points
              Topic:
                Depth: 5
                Durability Policy: Volatile
                History Policy: Keep Last
                Reliability Policy: Best Effort
                Value: /tof/front_left/points
              Use Fixed Frame: true
              Value: true
            - Alpha: 1
              Autocompute Intensity Bounds: true
              Class: rviz_default_plugins/PointCloud2
              Color: 200; 210; 220
              Color Transformer: FlatColor
              Decay Time: 0
              Enabled: true
              Name: Left
              Position Transformer: XYZ
              Selectable: true
              Size (Pixels): 3
              Size (m): 0.004
              Style: Points
              Topic:
                Depth: 5
                Durability Policy: Volatile
                History Policy: Keep Last
                Reliability Policy: Best Effort
                Value: /tof/left/points
              Use Fixed Frame: true
              Value: true
            - Alpha: 1
              Autocompute Intensity Bounds: true
              Class: rviz_default_plugins/PointCloud2
              Color: 200; 210; 220
              Color Transformer: FlatColor
              Decay Time: 0
              Enabled: true
              Name: Rear Left
              Position Transformer: XYZ
              Selectable: true
              Size (Pixels): 3
              Size (m): 0.004
              Style: Points
              Topic:
                Depth: 5
                Durability Policy: Volatile
                History Policy: Keep Last
                Reliability Policy: Best Effort
                Value: /tof/rear_left/points
              Use Fixed Frame: true
              Value: true
            - Alpha: 1
              Autocompute Intensity Bounds: true
              Class: rviz_default_plugins/PointCloud2
              Color: 200; 210; 220
              Color Transformer: FlatColor
              Decay Time: 0
              Enabled: true
              Name: Rear
              Position Transformer: XYZ
              Selectable: true
              Size (Pixels): 3
              Size (m): 0.004
              Style: Points
              Topic:
                Depth: 5
                Durability Policy: Volatile
                History Policy: Keep Last
                Reliability Policy: Best Effort
                Value: /tof/rear/points
              Use Fixed Frame: true
              Value: true
            - Alpha: 1
              Autocompute Intensity Bounds: true
              Class: rviz_default_plugins/PointCloud2
              Color: 200; 210; 220
              Color Transformer: FlatColor
              Decay Time: 0
              Enabled: true
              Name: Rear Right
              Position Transformer: XYZ
              Selectable: true
              Size (Pixels): 3
              Size (m): 0.004
              Style: Points
              Topic:
                Depth: 5
                Durability Policy: Volatile
                History Policy: Keep Last
                Reliability Policy: Best Effort
                Value: /tof/rear_right/points
              Use Fixed Frame: true
              Value: true
            - Alpha: 1
              Autocompute Intensity Bounds: true
              Class: rviz_default_plugins/PointCloud2
              Color: 200; 210; 220
              Color Transformer: FlatColor
              Decay Time: 0
              Enabled: true
              Name: Right
              Position Transformer: XYZ
              Selectable: true
              Size (Pixels): 3
              Size (m): 0.004
              Style: Points
              Topic:
                Depth: 5
                Durability Policy: Volatile
                History Policy: Keep Last
                Reliability Policy: Best Effort
                Value: /tof/right/points
              Use Fixed Frame: true
              Value: true
            - Alpha: 1
              Autocompute Intensity Bounds: true
              Class: rviz_default_plugins/PointCloud2
              Color: 200; 210; 220
              Color Transformer: FlatColor
              Decay Time: 0
              Enabled: true
              Name: Front Right
              Position Transformer: XYZ
              Selectable: true
              Size (Pixels): 3
              Size (m): 0.004
              Style: Points
              Topic:
                Depth: 5
                Durability Policy: Volatile
                History Policy: Keep Last
                Reliability Policy: Best Effort
                Value: /tof/front_right/points
              Use Fixed Frame: true
              Value: true
          Enabled: true
          Name: Raw returns (8 sensors)
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: Rays
          Namespaces:
            {}
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /tof/rays
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: Scene shapes
          Namespaces:
            {}
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /tof/shapes
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Class: rviz_default_plugins/PointCloud2
          Color: 240; 244; 248
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: false
          Name: Obstacle points
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 4
          Size (m): 0.012
          Style: Spheres
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /tof/obstacles
          Use Fixed Frame: true
          Value: false
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Class: rviz_default_plugins/PointCloud2
          Color: 48; 164; 108
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: false
          Name: Floor points
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.004
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /tof/floor
          Use Fixed Frame: true
          Value: false
      Enabled: true
      Name: ToF ring
    - Class: rviz_default_plugins/Odometry
      Covariance:
        Value: false
      Enabled: false
      Keep: 1
      Name: Raw Wheel Odometry
      Shape:
        Alpha: 1
        Axes Length: 0.12
        Axes Radius: 0.006
        Value: Axes
      Topic:
        Value: /mobile_base_controller/odometry
      Value: false
    - Class: rviz_default_plugins/Odometry
      Covariance:
        Value: false
      Enabled: true
      Keep: 1
      Name: Filtered Odometry
      Shape:
        Alpha: 1
        Axes Length: 0.12
        Axes Radius: 0.006
        Value: Axes
      Topic:
        Value: /odometry/filtered
      Value: true
    - Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.008
      Name: Raw Wheel Trajectory
      Pose Style: None
      Topic:
        Value: /mobile_base/trajectory
      Value: true
    - Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 220; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.008
      Name: Filtered Trajectory
      Pose Style: None
      Topic:
        Value: /mobile_base/filtered_trajectory
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Front Camera
      Normalize Range: true
      Topic:
        Value: /camera/image_raw
      Value: true
  Enabled: true
  Global Options:
    Background Color: 36; 38; 42
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0.03
      Name: Odom Trajectory View
      Near Clip Distance: 0.005
      Pitch: 0.95
      Target Frame: base_footprint
      Value: Orbit (rviz)
      Yaw: 0.75
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
