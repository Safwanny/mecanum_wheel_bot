# Drive to a planar pose through three sequential phases: rotate to face the
# goal, translate to it holding that heading, then rotate to the final
# orientation. Straight-line motion with no path planning - see the package
# docs for what that does and does not guarantee.

# Goal
float64 x            # target position in the reference frame, metres
float64 y
float64 theta_final  # final orientation, radians, wrapped to [-pi, pi]
---
# Result
bool success
string message                # why it ended, especially when success is false
float64 final_position_error  # metres between the robot and the goal position
float64 final_heading_error   # radians between the robot and theta_final
---
# Feedback
string state                 # IDLE, ALIGN, TRANSLATE, ORIENT or DONE
float64 distance_remaining   # metres to the goal position
float64 heading_error        # radians of the error the current phase is closing
