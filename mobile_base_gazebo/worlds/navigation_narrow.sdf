<?xml version="1.0"?>
<sdf version="1.9">
  <world name="navigation_narrow">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows>
      <diffuse>0.85 0.85 0.85 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.58 0.58 0.58 1</ambient><diffuse>0.58 0.58 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 1.0 m clear corridor, wider than the complete ~0.17 m wheel envelope. -->
    <model name="corridor_north">
      <static>true</static><pose>1.5 0.5 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>5.0 0.15 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.0 0.15 1.0</size></box></geometry></visual></link>
    </model>
    <model name="corridor_south">
      <static>true</static><pose>1.5 -0.5 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>5.0 0.15 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.0 0.15 1.0</size></box></geometry></visual></link>
    </model>

    <!-- Doorway at x=4: two wall segments leave a 1.0 m opening. -->
    <model name="doorway_lower">
      <static>true</static><pose>4 -2.0 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.15 3.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 3.0 1.0</size></box></geometry></visual></link>
    </model>
    <model name="doorway_upper">
      <static>true</static><pose>4 2.0 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.15 3.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 3.0 1.0</size></box></geometry></visual></link>
    </model>

    <!-- L-shaped turn into the upper open area. -->
    <model name="l_turn_outer">
      <static>true</static><pose>2.5 2.6 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.15 4.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 4.2 1.0</size></box></geometry></visual></link>
    </model>
    <model name="l_turn_inner">
      <static>true</static><pose>3.5 2.0 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.15 3.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 3.0 1.0</size></box></geometry></visual></link>
    </model>

    <!-- A separate dead-end branch west of the spawn. -->
    <model name="dead_end_north">
      <static>true</static><pose>-2.0 2.0 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>3.0 0.15 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.0 0.15 1.0</size></box></geometry></visual></link>
    </model>
    <model name="dead_end_south">
      <static>true</static><pose>-2.0 1.0 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>3.0 0.15 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.0 0.15 1.0</size></box></geometry></visual></link>
    </model>
    <model name="dead_end_cap">
      <static>true</static><pose>-3.5 1.5 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.15 1.15 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 1.15 1.0</size></box></geometry></visual></link>
    </model>
  </world>
</sdf>
