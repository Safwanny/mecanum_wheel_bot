<?xml version="1.0"?>
<sdf version="1.9">
  <world name="sensor_test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Known targets from the default spawn at (0, 0): front wall x=3 m,
         left box center=(1.5, 1.0), right cylinder center=(2.0, -1.0). -->
    <model name="front_wall">
      <static>true</static>
      <pose>3.0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.10 5.0 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.10 5.0 1.0</size></box></geometry>
          <material><ambient>0.75 0.20 0.20 1</ambient><diffuse>0.75 0.20 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="left_box">
      <static>true</static>
      <pose>1.5 1.0 0.30 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.60 0.60 0.60</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.60 0.60 0.60</size></box></geometry>
          <material><ambient>0.15 0.35 0.80 1</ambient><diffuse>0.15 0.35 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="right_cylinder">
      <static>true</static>
      <pose>2.0 -1.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.70</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.70</length></cylinder></geometry>
          <material><ambient>0.20 0.70 0.25 1</ambient><diffuse>0.20 0.70 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
