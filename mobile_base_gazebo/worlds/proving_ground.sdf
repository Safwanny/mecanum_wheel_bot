<?xml version="1.0"?>
<sdf version="1.9">
  <world name="proving_ground">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.28 0.28 0.31 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
      A raised deck the robot drives on, so every deck edge is a real drop.
      The ground_plane is an infinite collision plane and nothing falls through
      it, so a cliff has to be built as an absence of deck rather than as a
      hole in the ground.

      Deck top 0.12 m. SPAWN AT z:=0.22 - the launch default of 0.10 puts the
      robot on the floor beside the deck instead of on it.

          west                                              east
        +=================================================+
        |  bars 15/30/45/60/90 mm    |  gaps .45/.38/.32   |
        |                            |              +=====+   notch: the
        |     [ deck ]          doorsill    overhang | lane |   drop wraps
        |                            |              +=====+   an inside
        |  mezzanine 60 mm           |  thin pole          |   corner
        +=================================================+

      Note the box borders use '=' rather than '-'. A double hyphen cannot
      appear inside an XML comment, and this file is re-parsed with
      ElementTree at every launch.

      Several features are here to FAIL to trigger. The 15 mm bar is below
      what can be separated from the floor and the overhang is clearance the
      robot drives under; if either shows up in the costmap, the thresholds
      are producing false positives.
    -->

    <model name="deck_main">
      <static>true</static><pose>-0.6000 0.0000 0.0600 0.000000 0.000000 0.000000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.8000 6.0000 0.1200</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.8000 6.0000 0.1200</size></box></geometry>
          <material><ambient>0.32 0.30 0.26 1</ambient><diffuse>0.55 0.52 0.46 1</diffuse>
            <specular>0.2 0.2 0.25 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="deck_east_south">
      <static>true</static><pose>3.4000 -1.2000 0.0600 0.000000 0.000000 0.000000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2000 3.6000 0.1200</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2000 3.6000 0.1200</size></box></geometry>
          <material><ambient>0.32 0.30 0.26 1</ambient><diffuse>0.55 0.52 0.46 1</diffuse>
            <specular>0.2 0.2 0.25 1</specular></material>
        </visual>
      </link>
    </model>
