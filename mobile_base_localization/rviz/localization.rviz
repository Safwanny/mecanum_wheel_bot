Panels:
  - Class: rviz_common/Displays
    Name: Localization Displays
  - Class: rviz_common/Tool Properties
    Name: Initial Pose Tool
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Cell Size: 0.5
      Name: Localization Grid
      Plane Cell Count: 40
      Value: true
    - Alpha: 1
      Binary representation: false
      Binary threshold: 100
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: SAVED MAP - LOCALIZATION MODE
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Name: Robot Model
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF - AMCL owns map to odom
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/LaserScan
      Color: 255; 90; 30
      Color Transformer: FlatColor
      Decay Time: 0.5
      Enabled: true
      Name: Live LaserScan
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/PoseWithCovariance
      Enabled: true
      Name: AMCL Pose and Covariance
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /amcl_pose
      Value: true
    - Alpha: 1
      Class: nav2_rviz_plugins/ParticleCloud
      Color: 0; 210; 110
      Enabled: true
      Max Arrow Length: 0.30
      Min Arrow Length: 0.02
      Name: AMCL Particle Cloud
      Shape: Arrow (Flat)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /particle_cloud
      Value: true
    - Class: rviz_default_plugins/Odometry
      Covariance:
        Value: true
      Keep: 1
      Name: Filtered Local Odometry
      Shape: Axes
      Topic:
        Value: /odometry/filtered
      Value: true
    - Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 210; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: Local Odometry Trajectory
      Pose Style: None
      Topic:
        Value: /mobile_base/filtered_trajectory
      Value: true
  Enabled: true
  Global Options:
    Background Color: 24; 48; 38
    Fixed Frame: map
    Frame Rate: 30
  Name: LOCALIZATION MODE
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 255; 190; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Localization Top Down
      Scale: 80
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
