Panels:
  - Class: rviz_common/Displays
    Name: Particle Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Cell Size: 0.05
      Name: 5 cm grid
      Plane Cell Count: 60
      Reference Frame: base_footprint
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Name: Robot Model
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: false
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: Intensity
      Channel Name: intensity
      Decay Time: 0
      Enabled: true
      Invert Rainbow: true
      Max Color: 255; 60; 40
      Max Intensity: 1
      Min Color: 70; 70; 90
      Min Intensity: 0
      Name: ToF particles (bright = fresh)
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 5
      Size (m): 0.012
      Style: Spheres
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /tof/particles
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 170; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: ToF obstacles (live)
      Position Transformer: XYZ
      Selectable: true
      Size (m): 0.015
      Style: Spheres
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /tof/obstacles
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/LaserScan
      Color: 255; 90; 30
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: LiDAR scan plane
      Position Transformer: XYZ
      Selectable: true
      Size (m): 0.02
      Style: Spheres
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.5
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: true
      Enabled: true
      Name: Local costmap
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap_updates
      Use Timestamp: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 24; 24; 32
    Fixed Frame: odom
    Frame Rate: 30
  Name: TOF PARTICLES 3D
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.2
      Focal Point:
        X: 0
        Y: 0
        Z: 0.05
      Name: Orbit around robot
      Pitch: 0.55
      Target Frame: base_footprint
      Value: Orbit (rviz)
      Yaw: 3.6
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1100
